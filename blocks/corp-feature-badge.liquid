{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}

{%- assign _w = block.settings.width -%}
{%- if _w == 'custom' -%}{%- assign _w = block.settings.custom_width | append: '%' -%}{%- endif -%}
{%- assign _h = block.settings.height -%}
{%- if _h == 'custom' -%}{%- assign _h = block.settings.custom_height | append: 'px' -%}{%- endif -%}
<div class="corp-feat-badge" {{ block.shopify_attributes }} style="width:{{ _w }};height:{{ _h }};">
  {%- if block.settings.image -%}
    <div class="corp-feat-badge__icon" style="width:40px;height:40px;">
      <img src="{{ block.settings.image | image_url: width: 60 }}" alt="" width="28" height="28" style="object-fit:contain;width:28px;height:28px;">
    </div>
  {%- else -%}
    <div class="corp-feat-badge__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
    </div>
  {%- endif -%}
  <div class="corp-feat-badge__label">{{ block.settings.label }}</div>
</div>

{% schema %}
{
  "name": "Corp: Feature badge",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Icon image (optional)" },
    { "type": "richtext", "id": "label", "label": "Label", "default": "<p>Moisture Wicking</p>" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "width", "label": "Width",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "100%", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "100%"
    },
    {
      "type": "range", "id": "custom_width", "label": "Custom width",
      "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "100%", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range", "id": "custom_height", "label": "Custom height",
      "min": 50, "max": 800, "step": 10, "unit": "px", "default": 200,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    }
  ],
  "presets": [
    { "name": "Corp: Feature badge", "category": "Corporate" }
  ]
}
{% endschema %}
