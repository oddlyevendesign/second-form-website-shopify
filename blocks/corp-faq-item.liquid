{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}

{%- assign _w = block.settings.width -%}
{%- if _w == 'custom' -%}{%- assign _w = block.settings.custom_width | append: '%' -%}{%- endif -%}
<div class="corp-faq-item" {{ block.shopify_attributes }} style="width:{{ _w }};">
  <div class="corp-faq-item__q">
    <span>{{ block.settings.question }}</span>
    <span class="corp-faq-icon">+</span>
  </div>
  <div class="corp-faq-item__a">
    <div class="corp-faq-item__a-inner">{{ block.settings.answer }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Corp: FAQ item",
  "tag": null,
  "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "What is your MOQ?" },
    { "type": "textarea", "id": "answer", "label": "Answer", "default": "Our minimum order quantity is 12 pieces per style. For SF Plus, there is no minimum." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "width", "label": "Width",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "100%", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "100%"
    },
    {
      "type": "range", "id": "custom_width", "label": "Custom width",
      "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    }
  ],
  "presets": [
    { "name": "Corp: FAQ item", "category": "Corporate" }
  ]
}
{% endschema %}
