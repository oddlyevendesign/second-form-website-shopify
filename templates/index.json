    "featured_products_css": {
      "type": "custom-liquid",
      "name": "Featured Products CSS",
      "settings": {
        "custom_liquid": "<style>\n/* ═══ SECOND FORM BRAND OVERRIDES ═══ */\n\n/* ─ FONTS ─ */\n:root {\n  --font-heading--family: 'Funnel Display', serif;\n  --font-body--family: 'Funnel Sans', sans-serif;\n}\n\n/* ─ HERO: inset rounded card ─ */\n.hero-wrapper:first-of-type {\n  padding: 80px 32px 24px;\n  box-sizing: border-box;\n}\n.hero-wrapper:first-of-type .hero__container {\n  border-radius: 24px;\n  overflow: hidden;\n}\n\n/* ─ SECTION HEADINGS ─ */\n.section-resource-list__header h2,\n.section-resource-list__header h3,\n.section-resource-list__header .h2,\n.section-resource-list__header .h3 {\n  font-family: var(--font-heading--family) !important;\n  font-size: clamp(28px, 3.5vw, 46px) !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.04em !important;\n  line-height: 1 !important;\n  margin: 0 0 6px !important;\n}\n\n/* Section header row */\n.section-resource-list__header {\n  margin-bottom: 40px;\n}\n\n/* ─ CATEGORY CARDS: gradient + title overlay ─ */\n.collection-card--image-bg .collection-card__inner {\n  position: relative;\n}\n.collection-card--image-bg .collection-card__inner::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(transparent 45%, rgba(0,0,0,0.7) 100%);\n  pointer-events: none;\n  z-index: 1;\n  border-radius: inherit;\n}\n.collection-card--image-bg .collection-card__content {\n  position: absolute !important;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 20px !important;\n  z-index: 2;\n}\n.collection-card--image-bg .collection-card__content * {\n  color: #ffffff !important;\n  font-family: var(--font-heading--family) !important;\n  font-weight: 700 !important;\n  font-size: 1.125rem !important;\n  letter-spacing: -0.01em !important;\n  text-transform: uppercase !important;\n}\n\n/* ─ PRODUCT CARD IMAGES: portrait ratio ─ */\n.card-gallery {\n  aspect-ratio: 5 / 6;\n}\n.card-gallery img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* ─ PRODUCT-LIST SECTION PADDING ─ */\n.section-resource-list {\n  padding-top: 56px !important;\n  padding-bottom: 48px !important;\n}\n\n/* ─ SHOP THE LOOK: rounded ─ */\n[data-testid=\"product-hotspots\"] {\n  border-radius: 24px;\n  overflow: hidden;\n}\n\n/* ─ FAQ SECTION ─ */\n.section .accordion-block {\n  max-width: 920px;\n  margin: 0 auto;\n}\n\n/* ─ LOUNGE PHRASE background ─ */\n.sf-lp {\n  background: var(--color-background, #fff) !important;\n}\n\n/* ─ MOBILE ─ */\n@media (max-width: 749px) {\n  .hero-wrapper:first-of-type {\n    padding: 72px 16px 16px;\n  }\n  .section-resource-list__header h2,\n  .section-resource-list__header h3 {\n    font-size: clamp(24px, 7vw, 36px) !important;\n  }\n}\n</style>",
