                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "faq_2_text"
              ]
            },
            "faq_3": {
              "type": "_accordion-row",
              "name": "FAQ 3",
              "settings": {
                "heading": "What is your return policy?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "faq_3_text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We accept returns within 14 days of delivery. Items must be unworn, unwashed, and in original packaging. Sale items are final sale. To initiate a return, contact us at hello@secondform.in.</p>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
                    "font": "var(--font-body--family)",
                    "font_size": "0.9375rem",
                    "line_height": "1.7",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "faq_3_text"
              ]
            },
            "faq_4": {
              "type": "_accordion-row",
              "name": "FAQ 4",
              "settings": {
                "heading": "Do you offer free shipping?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "faq_4_text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes — we offer free shipping on all orders above ₹2,499. Standard delivery takes 3–5 business days. Express options are available at checkout.</p>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
                    "font": "var(--font-body--family)",
                    "font_size": "0.9375rem",
