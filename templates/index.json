        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "How does sizing work?",
            "answer": "Our fit is relaxed but not oversized. If you're between sizes, go up for lounge and down for hybrid silhouettes."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What is the return policy?",
            "answer": "Free returns within 15 days of delivery, on unworn pieces with tags intact."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
