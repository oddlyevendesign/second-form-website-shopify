    "sf_faq": {
      "type": "sf-faq",
      "settings": {
        "heading": "FREQUENTLY ASKED QUESTIONS"
      },
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What is your fabric sourcing philosophy?",
            "answer": "We source long-staple cottons and botanical-origin fibres certified under GOTS and Oeko-Tex 100. Every roll is traced back to the mill."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "How does sizing work?",
            "answer": "Our fit is relaxed but not oversized. If you're between sizes, go up for lounge and down for hybrid silhouettes."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What is the return policy?",
            "answer": "Free returns within 15 days of delivery, on unworn pieces with tags intact."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "Yes — we ship worldwide. Duties and taxes are calculated at checkout."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "How should I care for my Second Form pieces?",
            "answer": "Cold machine wash inside-out on gentle cycle, line dry. Our fabrics soften beautifully with every wash."
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4", "faq_5"]
