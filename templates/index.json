      "settings": {
        "custom_liquid": "<style>.sf-tst{padding:80px 24px;background:#fff;}.sf-tst-inner{max-width:1200px;margin:0 auto;}.sf-tst-lbl{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#7B7B76;margin-bottom:12px;display:block;}.sf-tst h2{font-family:var(--font-heading--family,serif);font-weight:700;font-size:clamp(28px,4vw,48px);letter-spacing:-0.03em;color:#523F38;margin:0 0 48px;line-height:1;}.sf-tst-q{font-family:var(--font-heading--family,serif);font-weight:700;font-size:clamp(18px,2.5vw,28px);line-height:1.2;letter-spacing:-0.02em;color:#332925;margin:0 0 24px;}.sf-tst-c{font-style:normal;font-size:14px;color:#523F38;letter-spacing:0.04em;}.sf-tst-nav{display:flex;gap:14px;margin-top:32px;align-items:center;}.sf-tst-btn{width:44px;height:44px;border:1px solid #E7E5E4;background:#fff;cursor:pointer;border-radius:50%;font-size:18px;color:#332925;transition:all 0.2s;}.sf-tst-btn:hover{background:#332925;color:#fff;}.sf-tst-dots{display:flex;gap:8px;margin-left:8px;align-items:center;}.sf-tst-dot{width:20px;height:2px;background:#E7E5E4;cursor:pointer;border:none;padding:0;transition:all 0.3s;}.sf-tst-dot.active{background:#332925;width:40px;}</style><div class=\"sf-tst\"><div class=\"sf-tst-inner\"><span class=\"sf-tst-lbl\">Customer Stories</span><h2>What Our Customers Say</h2><blockquote class=\"sf-tst-q\" id=\"sf-tst-q\"></blockquote><cite class=\"sf-tst-c\" id=\"sf-tst-c\"></cite><div class=\"sf-tst-nav\"><button class=\"sf-tst-btn\" id=\"sf-tst-prev\">&#8592;</button><button class=\"sf-tst-btn\" id=\"sf-tst-next\">&#8594;</button><div class=\"sf-tst-dots\" id=\"sf-tst-dots\"></div></div></div></div><script>(function(){var T=[{q:\"The quality is exceptional. Every piece feels luxurious and thoughtfully made. My go-to pieces for work from home and beyond.\",n:\"— Priya S., Bengaluru\"},{q:\"Finally found a brand that understands comfort without compromising style. The fabrics are so soft and the fit is perfect.\",n:\"— Kabir P., Mumbai\"},{q:\"The sustainable approach and attention to detail make this brand stand out. These pieces only get better with time.\",n:\"— Rohan K., Delhi\"},{q:\"Love the minimalist aesthetic. Every piece is versatile and well-made. Perfect from meetings to coffee runs to relaxing at home.\",n:\"— Aditya S., Pune\"}];var i=0;function render(){var t=T[i];var q=document.getElementById(\"sf-tst-q\");var c=document.getElementById(\"sf-tst-c\");var dots=document.getElementById(\"sf-tst-dots\");if(!q)return;q.textContent=\"“\"+t.q+\"”\";c.textContent=t.n;dots.innerHTML=\"\";T.forEach(function(_,idx){var b=document.createElement(\"button\");b.className=\"sf-tst-dot\"+(idx===i?\" active\":\"\");(function(ci){b.onclick=function(){i=ci;render();};})(idx);dots.appendChild(b);});}var p=document.getElementById(\"sf-tst-prev\"),nx=document.getElementById(\"sf-tst-next\");if(p)p.onclick=function(){i=(i-1+T.length)%T.length;render();};if(nx)nx.onclick=function(){i=(i+1)%T.length;render();};render();setInterval(function(){i=(i+1)%T.length;render();},7000);})();</script>",
