    "lounge_phrase_sf": {
      "type": "custom-liquid",
      "name": "Lounge Phrase",
      "settings": {
        "custom_liquid": "<style>.sf-lp{padding:96px 24px;text-align:center;overflow:hidden;background:#fff;}.sf-lp h2{max-width:1100px;margin:0 auto;font-family:var(--font-heading--family,serif);font-weight:700;font-size:clamp(22px,3.5vw,42px);line-height:1.3;letter-spacing:-0.015em;}.sf-lp .w{display:inline-block;color:#DFDACF;transition:color 0.15s linear;margin:0 2px;}.sf-lp .w.lit{color:#460C13;}</style><div class=\"sf-lp\"><h2 id=\"sf-lp-h2\"></h2></div><script>(function(){var text='Lounge and hybrid wear that moves with your life — from home to errands, work to travel — without ever asking you to choose between comfort and style.';var words=text.split(' ');var h=document.getElementById('sf-lp-h2');if(!h)return;h.textContent=\"\";words.forEach(function(w,i){if(i>0)h.appendChild(document.createTextNode(\" \"));var s=document.createElement(\"span\");s.className=\"w\";s.textContent=w;h.appendChild(s);});var spans=h.querySelectorAll(\".w\");function upd(){var r=h.getBoundingClientRect(),vh=window.innerHeight;var p=Math.max(0,Math.min(1,(vh-r.top)/(r.height+vh*0.8)));spans.forEach(function(s,i){if(p*1.15>i/spans.length)s.classList.add(\"lit\");else s.classList.remove(\"lit\");});}window.addEventListener('scroll',upd,{passive:true});upd();})();</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
