        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "What is the typical timeline?",
            "answer": "Standard orders take 21–28 days from approval. Priority orders (SF Premium and above) are delivered in 14–18 days."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Do you offer design customization?",
            "answer": "Yes — we can modify silhouettes, add logo placements (embroidery, print, woven labels), custom packaging, and more."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Can we see samples before placing an order?",
            "answer": "Absolutely. We produce a physical sample for approval before any production run begins."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "How is pricing structured?",
            "answer": "Pricing depends on fabric, quantity, customization complexity and timeline. Request a proposal and we'll send a detailed quote within 48 hours."
          }
        },
