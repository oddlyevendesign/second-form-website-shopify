{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<div class="corp-faq">
  <h2 class="corp-faq__heading" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
    {{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}
  </h2>

  <div class="corp-faq__list">
    {% content_for 'blocks' %}
  </div>
</div>

<script>
(function () {
  var items = document.querySelectorAll('.corp-faq-item');
  if (items[0]) items[0].classList.add('open');
  items.forEach(function (item) {
    item.querySelector('.corp-faq-item__q').addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      items.forEach(function (it) { it.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Corp: FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "blocks": [
    { "type": "corp-faq-item" }
  ],
  "presets": [
    {
      "name": "Corp: FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What is your MOQ?", "answer": "Our minimum order quantity starts at 12 pieces per style for SF Classic, 50 pieces for SF Premium. SF Plus has no minimum." } },
        { "type": "faq", "settings": { "question": "What is the typical timeline?", "answer": "Standard orders take 21–28 days from approval. Priority orders (SF Premium and above) are delivered in 14–18 days." } },
        { "type": "faq", "settings": { "question": "Do you offer design customization?", "answer": "Yes — we can modify silhouettes, add logo placements (embroidery, print, woven labels), custom packaging, and more." } },
        { "type": "faq", "settings": { "question": "Can we see samples before placing an order?", "answer": "Absolutely. We produce a physical sample for approval before any production run begins." } },
        { "type": "faq", "settings": { "question": "How is pricing structured?", "answer": "Pricing depends on fabric, quantity, customization complexity and timeline. Request a proposal and we'll send a detailed quote within 48 hours." } },
        { "type": "faq", "settings": { "question": "Do you ship internationally?", "answer": "Yes — we ship worldwide. Duties and taxes for international orders are calculated at checkout or included in your proposal quote." } }
      ]
    }
  ]
}
{% endschema %}
