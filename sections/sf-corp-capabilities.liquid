{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<div class="corp-capabilities">
  <div class="corp-capabilities__head">
    {%- if section.settings.eyebrow != blank -%}
      <span class="corp-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="corp-h2" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
      {{ section.settings.heading | default: 'Customization & Capabilities' }}
    </h2>
    {%- if section.settings.body != blank -%}
      <p class="corp-body" style="max-width:560px;margin:0 auto;">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  <div class="corp-cap-grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Corp: Capabilities",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT WE OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customization & Capabilities" },
    { "type": "textarea", "id": "body", "label": "Subheading body" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "blocks": [
    { "type": "corp-capability-card" },
    { "type": "corp-feature-badge" }
  ],
  "presets": [
    {
      "name": "Corp: Capabilities",
      "blocks": [
        { "type": "capability", "settings": { "title": "Fabric Selection", "body": "Choose from our premium CloudSoft™, LuxeModal™, EcoSoft™ and more." } },
        { "type": "capability", "settings": { "title": "Design Customization", "body": "Modify silhouettes, cuts and finishes to match your brand identity." } },
        { "type": "capability", "settings": { "title": "Logo Branding", "body": "Multiple placement and technique options — embroidery, print, woven labels." } },
        { "type": "capability", "settings": { "title": "Sizing Customization", "body": "Inclusive size ranges, graded to your requirements — XS through 4XL." } }
      ]
    }
  ]
}
{% endschema %}
