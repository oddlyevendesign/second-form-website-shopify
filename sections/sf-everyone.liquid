{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<section class="everyone-section">
  <div class="everyone-inner"
    {% if section.settings.background_image %}
      style="background-image: url('{{ section.settings.background_image | image_url: width: 1600 }}')"
    {% endif %}
  >
    <div>
      <h2>{{ section.settings.heading | default: "THERE'S SOMETHING<br>FOR EVERYONE" | newline_to_br }}</h2>
      <p>{{ section.settings.subheading | default: 'FIND YOUR SECOND SKIN' }}</p>
      <div class="btns">
        <a href="{{ section.settings.cta1_url | default: '/collections/women' }}" class="btn">{{ section.settings.cta1_label | default: 'Shop Women' }}</a>
        <a href="{{ section.settings.cta2_url | default: '/collections/men' }}" class="btn">{{ section.settings.cta2_label | default: 'Shop Men' }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SF: For Everyone",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (new line = line break)",
      "default": "THERE'S SOMETHING\nFOR EVERYONE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FIND YOUR SECOND SKIN"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Label",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "URL"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Label",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "URL"
    },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 100, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "SF: For Everyone" }
  ]
}
{% endschema %}
