{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}

{%- assign phrase_text = section.settings.phrase | default: 'LOUNGE AND HYBRID WEAR THAT MOVES WITH YOUR LIFE, FROM HOME TO ERRANDS, WORK TO TRAVEL, WITHOUT EVER ASKING YOU TO CHOOSE BETWEEN COMFORT AND STYLE.' -%}
{%- assign phrase_words = phrase_text | split: ' ' -%}
{%- assign font_size = section.settings.font_size | default: 44 -%}
{%- assign color_primary = section.settings.color_primary | default: '#460C13' -%}
{%- assign color_secondary = section.settings.color_secondary | default: '#DFDACF' -%}

<style>
  #sf-lounge-phrase-{{ section.id }} h2 { font-size: {{ font_size }}px; }
  @media (max-width: 767px) {
    #sf-lounge-phrase-{{ section.id }} h2 { font-size: 24px; }
  }
</style>

<section class="lounge-phrase" id="sf-lounge-phrase-{{ section.id }}"
  data-color-primary="{{ color_primary }}"
  data-color-secondary="{{ color_secondary }}">
  <h2>
    {%- for word in phrase_words -%}
      <span class="w">{{ word }}</span>
    {%- endfor -%}
  </h2>
</section>

<script>
(function () {
  var phrase = document.getElementById('sf-lounge-phrase-{{ section.id }}');
  if (!phrase) return;
  var words = phrase.querySelectorAll('.w');
  var colorPrimary = phrase.getAttribute('data-color-primary');
  var colorSecondary = phrase.getAttribute('data-color-secondary');
  function update() {
    var r = phrase.getBoundingClientRect();
    var vh = window.innerHeight;
    var total = r.height + vh * 0.8;
    var traveled = vh - r.top;
    var p = Math.max(0, Math.min(1, traveled / total));
    words.forEach(function (w, i) {
      w.style.color = (p * 1.15 > i / words.length) ? colorPrimary : colorSecondary;
    });
  }
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
})();
</script>

{% schema %}
{
  "name": "SF: Brand Phrase",
  "settings": [
    {
      "type": "textarea",
      "id": "phrase",
      "label": "Phrase text (all-caps, scroll-animated)",
      "default": "LOUNGE AND HYBRID WEAR THAT MOVES WITH YOUR LIFE, FROM HOME TO ERRANDS, WORK TO TRAVEL, WITHOUT EVER ASKING YOU TO CHOOSE BETWEEN COMFORT AND STYLE."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size (desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Scroll animation colours"
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Highlighted word colour",
      "default": "#460C13"
    },
    {
      "type": "color",
      "id": "color_secondary",
      "label": "Dim word colour",
      "default": "#DFDACF"
    }
  ],
  "presets": [
    { "name": "SF: Brand Phrase" }
  ]
}
{% endschema %}
