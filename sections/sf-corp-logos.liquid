{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<div class="corp-logos">
  <div class="corp-logos__head">
    {%- if section.settings.eyebrow != blank -%}
      <span class="corp-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="corp-h2" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
      {{ section.settings.heading | default: 'Built on Proven Manufacturing' }}
    </h2>
    {%- if section.settings.body != blank -%}
      <p class="corp-body" style="max-width:560px;margin:12px auto 0;">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  <div class="corp-logos__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.logo -%}
        <div class="corp-logo-item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" title="{{ block.settings.name }}" target="_blank" rel="noopener">
              <img src="{{ block.settings.logo | image_url: width: 280 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="140" height="48">
            </a>
          {%- else -%}
            <img src="{{ block.settings.logo | image_url: width: 280 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="140" height="48">
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Corp: Logos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TRUSTED BY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built on Proven Manufacturing" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Second Form is backed by export-grade manufacturing, trusted by leading brands across India and globally." },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Brand name (alt text)", "default": "Brand name" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Corp: Logos",
      "blocks": [
        { "type": "logo", "settings": { "name": "Brand 1" } },
        { "type": "logo", "settings": { "name": "Brand 2" } },
        { "type": "logo", "settings": { "name": "Brand 3" } },
        { "type": "logo", "settings": { "name": "Brand 4" } },
        { "type": "logo", "settings": { "name": "Brand 5" } }
      ]
    }
  ]
}
{% endschema %}
