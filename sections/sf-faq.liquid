{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<section class="faq-section">
  <h2>{{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}</h2>

  {%- for block in section.blocks -%}
    <div class="faq-item{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
      <div class="faq-q"><span>{{ block.settings.question }}</span><span class="plus">+</span></div>
      <div class="faq-a">{{ block.settings.answer }}</div>
    </div>
  {%- endfor -%}
</section>

<script>
(function () {
  var items = document.querySelectorAll('.faq-item');
  items.forEach(function (item) {
    item.addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      items.forEach(function (it) { it.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });
})();
</script>

{% schema %}
{
  "name": "SF: FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Your answer here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SF: FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your fabric sourcing philosophy?",
            "answer": "We source long-staple cottons and botanical-origin fibres certified under GOTS and Oeko-Tex 100. Every roll is traced back to the mill."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How does sizing work?",
            "answer": "Our fit is relaxed but not oversized. If you're between sizes, go up for lounge and down for hybrid silhouettes."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the return policy?",
            "answer": "Free returns within 15 days of delivery, on unworn pieces with tags intact."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "Yes — we ship worldwide. Duties and taxes are calculated at checkout."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How should I care for my Second Form pieces?",
            "answer": "Cold machine wash inside-out on gentle cycle, line dry. Our fabrics soften beautifully with every wash."
          }
        }
      ]
    }
  ]
}
{% endschema %}
