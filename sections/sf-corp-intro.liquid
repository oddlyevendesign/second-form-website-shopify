{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

{%- assign img_side = section.settings.image_position | default: 'right' -%}
<div class="corp-intro{% if img_side == 'left' %} img-left{% endif %}">
  <div class="corp-intro__text">
    {%- if section.settings.eyebrow != blank -%}
      <span class="corp-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="corp-intro__heading" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
      {{ section.settings.heading | default: 'Apparel Built Around Your Brand' }}
    </h2>
    {%- if section.settings.body != blank -%}
      <p class="corp-intro__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="btn">{{ section.settings.cta_label }}</a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="corp-stats" style="margin-top:40px;grid-template-columns:repeat({{ section.blocks.size }},1fr)">
        {%- for block in section.blocks -%}
          <div class="corp-stat" {{ block.shopify_attributes }}>
            <span class="corp-stat__value">{{ block.settings.value }}</span>
            <span class="corp-stat__label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="corp-intro__image">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" loading="lazy" width="900" height="1200">
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Corp: Intro",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image side", "default": "right", "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHO WE WORK WITH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apparel Built Around Your Brand" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "We work with teams to create apparel and gifting that feels aligned with your brand — designed to fit seamlessly into real work lives." },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "500+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Corporate clients" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Corp: Intro",
      "settings": {
        "eyebrow": "WHO WE WORK WITH",
        "heading": "Apparel Built Around Your Brand",
        "body": "We work with teams to create apparel and gifting that feels aligned with your brand — designed to fit seamlessly into real work lives."
      },
      "blocks": [
        { "type": "stat", "settings": { "value": "500+", "label": "Corporate clients" } },
        { "type": "stat", "settings": { "value": "50+", "label": "Countries shipped" } },
        { "type": "stat", "settings": { "value": "12", "label": "Min. order qty" } }
      ]
    }
  ]
}
{% endschema %}
