{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

{%- assign col_handle = section.settings.collection_handle | default: 'new-in' -%}
{%- assign col = collections[col_handle] -%}

<section class="products">
  <div class="section-head">
    <div>
      <h2>{{ section.settings.heading | default: 'NEW IN' }}</h2>
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'The Essentials' }}</span>
    </div>
    <a href="/collections/{{ col_handle }}" class="btn-outline">{{ section.settings.view_all_label | default: 'View All' }}</a>
  </div>
  <div class="product-grid">
    {%- if col != blank and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.product_limit -%}
        <a href="{{ product.url }}" class="product-card reveal">
          <div class="img-wrap">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="697">
            {%- endif -%}
            <div class="sf-quick-add"
              data-single-id="{{ product.variants.first.id }}"
              {%- if product.variants.size > 1 -%}data-has-variants="true"{%- endif -%}>
              <span class="sf-qa-default">QUICK ADD</span>
              {%- if product.variants.size > 1 -%}
                <div class="sf-qa-picker">
                  {%- for variant in product.variants -%}
                    <span class="sf-qa-opt{% unless variant.available %} sf-qa-opt--sold{% endunless %}"
                      data-id="{{ variant.id }}"
                      data-available="{{ variant.available }}">{{ variant.title }}</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <span class="sf-qa-loading"><span></span><span></span><span></span></span>
              <span class="sf-qa-added">ADDED ✓</span>
            </div>
          </div>
          <div class="meta">
            <div>
              <div class="name">{{ product.title | upcase }}</div>
              <div class="sub">
                {%- assign vt = product.variants.first.title -%}
                {%- if vt != 'Default Title' -%}{{ vt }}{%- elsif product.type != blank -%}{{ product.type }}{%- endif -%}
              </div>
            </div>
            <div class="price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card reveal">
          <div class="img-wrap" style="background:var(--cream);"></div>
          <div class="meta">
            <div>
              <div class="name">SECOND FORM PIECE</div>
              <div class="sub">Add products to {{ col_handle }} collection</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  /* ---------- Reveal on scroll ---------- */
  if (!window._sfRevealInit) {
    window._sfRevealInit = true;
    function initReveal() {
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initReveal); } else { initReveal(); }
  }

  /* ---------- Quick Add ---------- */
  function addToCart(variantId, qaEl) {
    qaEl.classList.remove('sf-qa--picking');
    qaEl.classList.add('sf-qa--loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function (r) {
      if (!r.ok) throw new Error('cart error');
      return r.json();
    })
    .then(function () {
      qaEl.classList.remove('sf-qa--loading');
      qaEl.classList.add('sf-qa--added');
      /* update any cart count bubbles the theme renders */
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.querySelectorAll('[data-cart-count], .cart-count, .js-cart-count').forEach(function (el) {
            el.textContent = cart.item_count;
            el.setAttribute('data-cart-count', cart.item_count);
          });
        });
      setTimeout(function () { qaEl.classList.remove('sf-qa--added'); }, 2200);
    })
    .catch(function () {
      qaEl.classList.remove('sf-qa--loading');
    });
  }

  document.addEventListener('click', function (e) {
    var qa = e.target.closest('.sf-quick-add');
    if (!qa) return;
    e.preventDefault();
    e.stopPropagation();

    /* clicking a size option */
    var opt = e.target.closest('.sf-qa-opt');
    if (opt) {
      if (opt.dataset.available === 'false') return;
      addToCart(opt.dataset.id, qa);
      return;
    }

    /* clicking the main button */
    if (qa.dataset.hasVariants) {
      qa.classList.toggle('sf-qa--picking');
    } else {
      addToCart(qa.dataset.singleId, qa);
    }
  });

  /* close picker when clicking outside */
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.sf-quick-add')) {
      document.querySelectorAll('.sf-quick-add.sf-qa--picking').forEach(function (el) {
        el.classList.remove('sf-qa--picking');
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "SF: New In",
  "settings": [
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "new-in"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW IN"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Essentials"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All"
    },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 }
  ],
  "presets": [
    { "name": "SF: New In" }
  ]
}
{% endschema %}
