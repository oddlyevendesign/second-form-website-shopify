{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign new_in_handle = section.settings.new_in_collection | default: 'new-in'
  assign loved_handle = section.settings.most_loved_collection | default: 'bestsellers'
  assign new_in_col = collections[new_in_handle]
  assign loved_col = collections[loved_handle]
-%}

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner"
    {% if section.settings.hero_image %}
      style="background-image: url('{{ section.settings.hero_image | image_url: width: 2000 }}')"
    {% endif %}
  >
    <div class="hero-content">
      <h1>MADE FOR SLOW<br>MORNINGS, LONG DAYS,<br>AND EVERYTHING IN<br>BETWEEN.</h1>
      <p class="tagline">Fashion that moves with you</p>
      <div style="display:flex; gap:16px; flex-wrap:wrap;">
        <a href="/collections/women" class="btn">Shop Women</a>
        <a href="/collections/men" class="btn btn-light">Shop Men</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== NEW IN ===== -->
<section class="products">
  <div class="section-head">
    <div>
      <h2>NEW IN</h2>
      <span class="eyebrow">The Essentials</span>
    </div>
    <a href="/collections/{{ new_in_handle }}" class="btn-outline">View All</a>
  </div>
  <div class="product-grid">
    {%- if new_in_col != blank and new_in_col.products_count > 0 -%}
      {%- for product in new_in_col.products limit: 4 -%}
        <a href="{{ product.url }}" class="product-card reveal">
          <div class="img-wrap">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="697">
            {%- endif -%}
            <div class="sf-quick-add">QUICK ADD +</div>
          </div>
          <div class="meta">
            <div>
              <div class="name">{{ product.title | upcase }}</div>
              <div class="sub">
                {%- assign vt = product.variants.first.title -%}
                {%- if vt != 'Default Title' -%}{{ vt }}{%- elsif product.type != blank -%}{{ product.type }}{%- endif -%}
              </div>
            </div>
            <div class="price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card reveal">
          <div class="img-wrap" style="background:var(--cream);"></div>
          <div class="meta">
            <div>
              <div class="name">SECOND FORM PIECE</div>
              <div class="sub">Add products to New In collection</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<!-- ===== SHOP THE LOOK ===== -->
<section style="padding: 24px 0;">
  <div class="shop-the-look"
    {% if section.settings.shop_the_look_image %}
      style="background-image: url('{{ section.settings.shop_the_look_image | image_url: width: 1600 }}')"
    {% endif %}
  >
    <div class="stl-head">
      <h2>SHOP THE LOOK</h2>
      <span class="eyebrow" style="color:var(--bone-2)">our faves, for you</span>
    </div>
    <div class="stl-pin" style="left:42%;top:66%;">
      <div class="stl-dot"></div>
      <div class="stl-tag stl-tag--left">
        <div class="sw"
          {% if section.settings.stl_pin1_image %}
            style="background-image: url('{{ section.settings.stl_pin1_image | image_url: width: 100 }}')"
          {% endif %}
        ></div>
        <div>
          <div class="nm">{{ section.settings.stl_pin1_name | default: 'Knitted Pants' }}</div>
          <div class="pr">{{ section.settings.stl_pin1_price | default: 'Rs 3,250' }}</div>
        </div>
      </div>
    </div>
    <div class="stl-pin" style="left:58%;top:46%;">
      <div class="stl-dot"></div>
      <div class="stl-tag stl-tag--right">
        <div class="sw"
          {% if section.settings.stl_pin2_image %}
            style="background-image: url('{{ section.settings.stl_pin2_image | image_url: width: 100 }}')"
          {% endif %}
        ></div>
        <div>
          <div class="nm">{{ section.settings.stl_pin2_name | default: 'Knitted Top' }}</div>
          <div class="pr">{{ section.settings.stl_pin2_price | default: 'Rs 3,250' }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== LOUNGE PHRASE ===== -->
<section class="lounge-phrase" id="sf-lounge-phrase">
  <h2>
    {%- assign lp_text = "LOUNGE AND HYBRID WEAR THAT MOVES WITH YOUR LIFE, FROM HOME TO ERRANDS, WORK TO TRAVEL, WITHOUT EVER ASKING YOU TO CHOOSE BETWEEN COMFORT AND STYLE." -%}
    {%- assign lp_words = lp_text | split: ' ' -%}
    {%- for word in lp_words -%}
      <span class="w">{{ word }}</span>
    {%- endfor -%}
  </h2>
</section>

<!-- ===== SHOP BY CATEGORY ===== -->
<section class="category-section">
  <div class="section-head on-dark">
    <div>
      <h2>SHOP BY CATEGORY</h2>
      <span class="eyebrow">we've got it all</span>
    </div>
    <a href="/collections/all" class="btn-outline on-dark">View All</a>
  </div>
  <div class="category-grid">
    <a href="/collections/lounging-at-home" class="cat-card reveal">
      {% if section.settings.cat_1_image %}
        <img src="{{ section.settings.cat_1_image | image_url: width: 600 }}" alt="Lounging at Home" loading="lazy">
      {% endif %}
      <span class="cat-num">01</span>
      <span class="cat-label">LOUNGING AT HOME</span>
    </a>
    <a href="/collections/travel-edit" class="cat-card reveal">
      {% if section.settings.cat_2_image %}
        <img src="{{ section.settings.cat_2_image | image_url: width: 600 }}" alt="Travel Edit" loading="lazy">
      {% endif %}
      <span class="cat-num">02</span>
      <span class="cat-label">TRAVEL EDIT</span>
    </a>
    <a href="/collections/women" class="cat-card reveal">
      {% if section.settings.cat_3_image %}
        <img src="{{ section.settings.cat_3_image | image_url: width: 600 }}" alt="Daily Essentials" loading="lazy">
      {% endif %}
      <span class="cat-num">03</span>
      <span class="cat-label">DAILY ESSENTIALS</span>
    </a>
    <a href="/collections/out-and-about" class="cat-card reveal">
      {% if section.settings.cat_4_image %}
        <img src="{{ section.settings.cat_4_image | image_url: width: 600 }}" alt="Out & About" loading="lazy">
      {% endif %}
      <span class="cat-num">04</span>
      <span class="cat-label">OUT &amp; ABOUT</span>
    </a>
  </div>
</section>

<!-- ===== EVERYONE ===== -->
<section class="everyone-section">
  <div class="everyone-inner"
    {% if section.settings.everyone_image %}
      style="background-image: url('{{ section.settings.everyone_image | image_url: width: 1600 }}')"
    {% endif %}
  >
    <div>
      <h2>THERE'S SOMETHING<br>FOR EVERYONE</h2>
      <p>FIND YOUR SECOND SKIN</p>
      <div class="btns">
        <a href="/collections/women" class="btn">Shop Women</a>
        <a href="/collections/men" class="btn">Shop Men</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== FABRICS — Desktop (7 tabs) ===== -->
<section class="fabrics" id="sf-fabrics-section">
  <span class="eyebrow" style="display:block;text-align:center;color:var(--chocolate);margin-bottom:12px;">OUR FABRICS</span>
  <h2>OUR FABRICS</h2>
  <div class="fabric-tabs">
    <button class="fabric-tab active" data-fab="0">French Terry</button>
    <button class="fabric-tab" data-fab="1">Ribbed Jersey</button>
    <button class="fabric-tab" data-fab="2">Combed Pima</button>
    <button class="fabric-tab" data-fab="3">Tumbled Linen</button>
    <button class="fabric-tab" data-fab="4">Brushed Fleece</button>
    <button class="fabric-tab" data-fab="5">Soft Modal</button>
    <button class="fabric-tab" data-fab="6">Washed Canvas</button>
  </div>
  <div class="fabric-viewer">

    <div class="fabric-panel active" data-fab="0">
      <div class="fabric-swatch">
        <div class="inner" data-name="French Terry"
          {% if section.settings.fab_1_image %}style="background-image:url('{{ section.settings.fab_1_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Second-Skin Softness</span>
        <h3>ULTRA SOFT WITH EFFORTLESS BREATHABILITY</h3>
        <p>Our signature French Terry is brushed for a plush hand-feel on the inside and a clean, structured drape on the outside — built to soften beautifully with every wash.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>72%</b><span>Organic Cotton</span></div>
          <div class="fabric-prop"><b>260 GSM</b><span>Midweight</span></div>
          <div class="fabric-prop"><b>PRE-SHRUNK</b><span>Finished</span></div>
          <div class="fabric-prop"><b>CERTIFIED</b><span>GOTS</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="1">
      <div class="fabric-swatch">
        <div class="inner" data-name="Ribbed Jersey"
          {% if section.settings.fab_2_image %}style="background-image:url('{{ section.settings.fab_2_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Fluid Movement</span>
        <h3>4-WAY STRETCH THAT ADAPTS TO YOUR BODY</h3>
        <p>A close-knit rib with a weighted, resilient feel. Sculpts softly, holds its shape, and moves with you — equal parts lounge and street.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>88%</b><span>Modal Cotton</span></div>
          <div class="fabric-prop"><b>220 GSM</b><span>Lightweight</span></div>
          <div class="fabric-prop"><b>Anti-pill</b><span>Treated</span></div>
          <div class="fabric-prop"><b>Made in</b><span>India</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="2">
      <div class="fabric-swatch">
        <div class="inner" data-name="Combed Pima"
          {% if section.settings.fab_3_image %}style="background-image:url('{{ section.settings.fab_3_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Everyday Essential</span>
        <h3>MADE FOR DAILY WEAR WITH ALL-DAY EASE</h3>
        <p>Long-staple Pima, combed twice for an unusually smooth surface. Cool to the touch, unbothered by wrinkles, and engineered to outlast trends.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>100%</b><span>Pima Cotton</span></div>
          <div class="fabric-prop"><b>180 GSM</b><span>Breathable</span></div>
          <div class="fabric-prop"><b>Machine</b><span>Washable</span></div>
          <div class="fabric-prop"><b>Oeko-Tex</b><span>100</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="3">
      <div class="fabric-swatch">
        <div class="inner" data-name="Tumbled Linen"
          {% if section.settings.fab_4_image %}style="background-image:url('{{ section.settings.fab_4_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Quiet Luxury</span>
        <h3>AIRY, RELAXED, LIVED-IN FROM DAY ONE</h3>
        <p>Stone-washed European flax with a crumpled, characterful drape. Cooler than cotton, lighter than it looks, and only better-looking with age.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>100%</b><span>European Flax</span></div>
          <div class="fabric-prop"><b>160 GSM</b><span>Summer</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="4">
      <div class="fabric-swatch">
        <div class="inner" data-name="Brushed Fleece"
          {% if section.settings.fab_5_image %}style="background-image:url('{{ section.settings.fab_5_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Warm &amp; Weightless</span>
        <h3>INSULATED COMFORT, WITHOUT THE BULK</h3>
        <p>Loft-spun fleece with a quick-dry inner face. The warmth of heavier knits without giving up drape or breathability.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>65%</b><span>Recycled Poly</span></div>
          <div class="fabric-prop"><b>320 GSM</b><span>Heavy</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="5">
      <div class="fabric-swatch">
        <div class="inner" data-name="Soft Modal"
          {% if section.settings.fab_6_image %}style="background-image:url('{{ section.settings.fab_6_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Second-Skin Softness</span>
        <h3>SILKEN DRAPE WITH BREATHABLE STRUCTURE</h3>
        <p>Botanical fibres spun into a featherweight jersey. Wears like water against the skin and settles into your body without clinging.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>95%</b><span>Modal</span></div>
          <div class="fabric-prop"><b>170 GSM</b><span>Light</span></div>
        </div>
      </div>
    </div>

    <div class="fabric-panel" data-fab="6">
      <div class="fabric-swatch">
        <div class="inner" data-name="Washed Canvas"
          {% if section.settings.fab_7_image %}style="background-image:url('{{ section.settings.fab_7_image | image_url: width: 600 }}')"{% endif %}></div>
      </div>
      <div class="fabric-info">
        <span class="eyebrow">Built for Travel</span>
        <h3>DURABLE STRUCTURE, BROKEN-IN FEEL</h3>
        <p>Heavy-grain cotton canvas, enzyme-washed until it moves like it's been yours for years. Holds tailoring; forgives everything.</p>
        <div class="fabric-props">
          <div class="fabric-prop"><b>100%</b><span>Heavy Cotton</span></div>
          <div class="fabric-prop"><b>340 GSM</b><span>Structured</span></div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ===== CLOUDSOFT FABRICS — Mobile (7 branded tabs) ===== -->
<section class="cs-fabrics" id="sf-cs-fabrics-section">
  <h2 class="cs-fab-title">OUR FABRICS</h2>
  <div class="cs-fab-tabs">
    <button class="cs-fab-tab active" data-cs="0">CLOUDSOFT™</button>
    <button class="cs-fab-tab" data-cs="1">LUXEMODAL™</button>
    <button class="cs-fab-tab" data-cs="2">AIRSOFT™</button>
    <button class="cs-fab-tab" data-cs="3">ECOSOFT™</button>
    <button class="cs-fab-tab" data-cs="4">ECOLITE™</button>
    <button class="cs-fab-tab" data-cs="5">SCULPTSTRETCH™</button>
    <button class="cs-fab-tab" data-cs="6">TEXTURERIB™</button>
  </div>

  {%- assign cs_fab_images = 'cs_fab_1_image,cs_fab_2_image,cs_fab_3_image,cs_fab_4_image,cs_fab_5_image,cs_fab_6_image,cs_fab_7_image' | split: ',' -%}
