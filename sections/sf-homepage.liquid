<script>
(function () {
  /* ---- Lounge Phrase scroll color ---- */
  var phrase = document.getElementById('sf-lounge-phrase');
  if (phrase) {
    var words = phrase.querySelectorAll('.w');
    function updatePhrase() {
      var r = phrase.getBoundingClientRect();
      var vh = window.innerHeight;
      var total = r.height + vh * 0.8;
      var traveled = vh - r.top;
      var p = Math.max(0, Math.min(1, traveled / total));
      words.forEach(function (w, i) {
        w.style.color = (p * 1.15 > i / words.length) ? 'var(--chocolate)' : 'var(--bone-2)';
      });
    }
    updatePhrase();
    window.addEventListener('scroll', updatePhrase, { passive: true });
    window.addEventListener('resize', updatePhrase);
  }

  /* ---- Fabric tabs (desktop) ---- */
  var fabTabs = document.querySelectorAll('.fabric-tab');
  var fabPanels = document.querySelectorAll('#sf-fabrics-section .fabric-panel');
  fabTabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var idx = tab.getAttribute('data-fab');
      fabTabs.forEach(function (t) { t.classList.remove('active'); });
      fabPanels.forEach(function (p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.querySelector('#sf-fabrics-section .fabric-panel[data-fab="' + idx + '"]');
      if (panel) panel.classList.add('active');
    });
  });

  /* ---- CloudSoft fabric tabs (mobile) ---- */
  var csTabs = document.querySelectorAll('.cs-fab-tab');
  var csPanels = document.querySelectorAll('#sf-cs-fabrics-section .cs-fab-panel');
  csTabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var idx = tab.getAttribute('data-cs');
      csTabs.forEach(function (t) { t.classList.remove('active'); });
      csPanels.forEach(function (p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.querySelector('#sf-cs-fabrics-section .cs-fab-panel[data-cs="' + idx + '"]');
      if (panel) panel.classList.add('active');
    });
  });

  /* ---- Testimonials carousel ---- */
  var testiItems = document.querySelectorAll('.testi-item');
  var testiDots = document.querySelectorAll('.sf-testi-dot');
  var prevBtn = document.getElementById('sf-testi-prev');
  var nextBtn = document.getElementById('sf-testi-next');
  var currentTesti = 0;
  var testiTimer;

  function showTesti(i) {
    currentTesti = (i + testiItems.length) % testiItems.length;
    testiItems.forEach(function (it) { it.classList.remove('active'); });
    testiDots.forEach(function (d) { d.classList.remove('active'); });
    if (testiItems[currentTesti]) testiItems[currentTesti].classList.add('active');
    if (testiDots[currentTesti]) testiDots[currentTesti].classList.add('active');
  }

  function startTestiTimer() {
    clearInterval(testiTimer);
    testiTimer = setInterval(function () { showTesti(currentTesti + 1); }, 7000);
  }

  showTesti(0);
  startTestiTimer();

  if (prevBtn) prevBtn.addEventListener('click', function () { showTesti(currentTesti - 1); startTestiTimer(); });
  if (nextBtn) nextBtn.addEventListener('click', function () { showTesti(currentTesti + 1); startTestiTimer(); });
  testiDots.forEach(function (dot, i) {
    dot.addEventListener('click', function () { showTesti(i); startTestiTimer(); });
  });

  /* ---- FAQ accordion ---- */
  var faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(function (item) {
    item.addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      faqItems.forEach(function (it) { it.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

  /* ---- Reveal on scroll ---- */
  if ('IntersectionObserver' in window) {
    var revealObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); revealObs.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(function (el) { revealObs.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
  }
})();
</script>

