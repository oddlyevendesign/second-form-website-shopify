{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<div class="corp-how">
  <div class="corp-how__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="corp-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="corp-how__heading" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
        {{ section.settings.heading | default: 'HOW IT WORKS' }}
      </h2>
    </div>
    {%- if section.settings.body != blank -%}
      <p class="corp-how__body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  <div class="corp-how-steps">
    {% content_for 'blocks' %}
  </div>

  <style>
    .corp-how-steps { counter-reset: corp-step; }
    .corp-how-step__num { counter-increment: corp-step; }
    .corp-how-step__num::before { content: counter(corp-step, decimal-leading-zero); }
  </style>
</div>

{% schema %}
{
  "name": "Corp: How It Works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PROCESS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW IT WORKS" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "A streamlined process from first inquiry to final delivery — with a dedicated account manager at every step." },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "blocks": [
    { "type": "corp-step" }
  ],
  "presets": [
    {
      "name": "Corp: How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Submit Inquiry", "body": "Share your requirements, timeline, and budget through our proposal form." } },
        { "type": "step", "settings": { "title": "Design & Sampling", "body": "Our team creates samples aligned to your brand — reviewed and revised until perfect." } },
        { "type": "step", "settings": { "title": "Approval & Production", "body": "Once approved, production begins with full quality control at every stage." } },
        { "type": "step", "settings": { "title": "Delivery", "body": "On-time delivery to your door — anywhere in India and worldwide." } }
      ]
    }
  ]
}
{% endschema %}
