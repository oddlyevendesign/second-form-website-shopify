{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}

<section class="fabrics" id="sf-fabrics-{{ section.id }}">
  <span class="eyebrow" style="display:block;text-align:center;color:var(--chocolate);margin-bottom:12px;">OUR FABRICS</span>
  <h2>OUR FABRICS</h2>

  <div class="fabric-tabs">
    {%- for block in section.blocks -%}
      <button class="fabric-tab{% if forloop.first %} active{% endif %}" data-fab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {{ block.settings.tab_label | default: 'Fabric' }}
      </button>
    {%- endfor -%}
  </div>

  <div class="fabric-viewer">
    {%- for block in section.blocks -%}
      <div class="fabric-panel{% if forloop.first %} active{% endif %}" data-fab="{{ forloop.index0 }}">
        <div class="fabric-swatch">
          <div class="inner" data-name="{{ block.settings.tab_label | escape }}"
            {% if block.settings.image %}style="background-image:url('{{ block.settings.image | image_url: width: 600 }}')"{% endif %}>
          </div>
        </div>
        <div class="fabric-info">
          {%- if block.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
          <div class="fabric-props">
            {%- if block.settings.prop1_value != blank -%}
              <div class="fabric-prop"><b>{{ block.settings.prop1_value }}</b><span>{{ block.settings.prop1_label }}</span></div>
            {%- endif -%}
            {%- if block.settings.prop2_value != blank -%}
              <div class="fabric-prop"><b>{{ block.settings.prop2_value }}</b><span>{{ block.settings.prop2_label }}</span></div>
            {%- endif -%}
            {%- if block.settings.prop3_value != blank -%}
              <div class="fabric-prop"><b>{{ block.settings.prop3_value }}</b><span>{{ block.settings.prop3_label }}</span></div>
            {%- endif -%}
            {%- if block.settings.prop4_value != blank -%}
              <div class="fabric-prop"><b>{{ block.settings.prop4_value }}</b><span>{{ block.settings.prop4_label }}</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
(function () {
  var sec = document.getElementById('sf-fabrics-{{ section.id }}');
  if (!sec) return;
  var tabs = sec.querySelectorAll('.fabric-tab');
  var panels = sec.querySelectorAll('.fabric-panel');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var idx = tab.getAttribute('data-fab');
      tabs.forEach(function (t) { t.classList.remove('active'); });
      panels.forEach(function (p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = sec.querySelector('.fabric-panel[data-fab="' + idx + '"]');
      if (panel) panel.classList.add('active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "SF: Fabrics",
  "blocks": [
    {
      "type": "fabric",
      "name": "Fabric",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Swatch image"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "CloudSoft™"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Second-Skin Softness"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ULTRA-SOFT WITH EFFORTLESS BREATHABILITY"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Fabric stats (up to 4)"
        },
        {
          "type": "text",
          "id": "prop1_value",
          "label": "Stat 1 value",
          "default": "72%"
        },
        {
          "type": "text",
          "id": "prop1_label",
          "label": "Stat 1 label",
          "default": "Organic Cotton"
        },
        {
          "type": "text",
          "id": "prop2_value",
          "label": "Stat 2 value"
        },
        {
          "type": "text",
          "id": "prop2_label",
          "label": "Stat 2 label"
        },
        {
          "type": "text",
          "id": "prop3_value",
          "label": "Stat 3 value"
        },
        {
          "type": "text",
          "id": "prop3_label",
          "label": "Stat 3 label"
        },
        {
          "type": "text",
          "id": "prop4_value",
          "label": "Stat 4 value"
        },
        {
          "type": "text",
          "id": "prop4_label",
          "label": "Stat 4 label"
        }
      ]
    }
  ],
  "presets": [
    { "name": "SF: Fabrics" }
  ]
}
{% endschema %}
