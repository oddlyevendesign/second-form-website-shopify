{{ 'sf-homepage.css' | asset_url | stylesheet_tag }}

<section class="testimonials">
  <span class="eyebrow">{{ section.settings.eyebrow | default: 'CUSTOMER STORIES' }}</span>
  <h2>{{ section.settings.heading | default: 'WHAT OUR CUSTOMERS SAY' }}</h2>

  {%- for block in section.blocks -%}
    <div class="testi-item{% if forloop.first %} active{% endif %}" data-testi="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
      <div class="testi-image"
        {% if block.settings.image %}style="background-image:url('{{ block.settings.image | image_url: width: 600 }}')"{% endif %}>
        <div class="testi-city">{{ block.settings.city | default: 'INDIA' | upcase }}</div>
      </div>
      <div class="testi-body">
        <blockquote>"{{ block.settings.quote }}"</blockquote>
        <cite>— {{ block.settings.author }}</cite><br>
        {%- if block.settings.link_url != blank -%}
          <a href="{{ block.settings.link_url }}" class="collection-link">{{ block.settings.link_label | default: 'Shop Now →' }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  <div class="testi-nav">
    <button id="sf-testi-prev" aria-label="Previous testimonial">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="transform:rotate(180deg)"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <button id="sf-testi-next" aria-label="Next testimonial">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <div class="testi-dots">
      {%- for block in section.blocks -%}
        <span class="sf-testi-dot{% if forloop.first %} active{% endif %}" data-testi="{{ forloop.index0 }}"></span>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var items = document.querySelectorAll('.testi-item');
  var dots = document.querySelectorAll('.sf-testi-dot');
  var prevBtn = document.getElementById('sf-testi-prev');
  var nextBtn = document.getElementById('sf-testi-next');
  var current = 0;
  var timer;

  function show(i) {
    current = (i + items.length) % items.length;
    items.forEach(function (el) { el.classList.remove('active'); });
    dots.forEach(function (d) { d.classList.remove('active'); });
    if (items[current]) items[current].classList.add('active');
    if (dots[current]) dots[current].classList.add('active');
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(function () { show(current + 1); }, 7000);
  }

  show(0);
  startTimer();

  if (prevBtn) prevBtn.addEventListener('click', function () { show(current - 1); startTimer(); });
  if (nextBtn) nextBtn.addEventListener('click', function () { show(current + 1); startTimer(); });
  dots.forEach(function (dot, i) {
    dot.addEventListener('click', function () { show(i); startTimer(); });
  });
})();
</script>

{% schema %}
{
  "name": "SF: Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CUSTOMER STORIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT OUR CUSTOMERS SAY"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "BENGALURU"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote (no quotation marks needed)",
          "default": "The quality is exceptional. Every piece feels luxurious and thoughtfully made."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Priya Sharma"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the Collection →"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SF: Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "city": "BENGALURU",
            "quote": "The quality is exceptional. Every piece feels luxurious and thoughtfully made. These have become my go-to pieces for work from home and beyond.",
            "author": "Priya Sharma",
            "link_label": "Shop the Co-ord Collection →"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "city": "MUMBAI",
            "quote": "Finally found a brand that understands comfort without compromising style. The fabrics are soft and the fit is perfect. Worth every penny!",
            "author": "Kabir Patel",
            "link_label": "Shop the Lounge Collection →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
