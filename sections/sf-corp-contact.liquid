{{ 'sf-corporate.css' | asset_url | stylesheet_tag }}
{% render 'sf-section-styles', section: section %}

<div class="corp-contact" id="contact">
  <div class="corp-contact__text">
    {%- if section.settings.eyebrow != blank -%}
      <span class="corp-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="corp-contact__heading" style="{% if section.settings.heading_size > 0 %}font-size:{{ section.settings.heading_size }}px;{% endif %}">
      {{ section.settings.heading | default: 'REQUEST A PROPOSAL' }}
    </h2>
    {%- if section.settings.subheading != blank -%}
      <p class="corp-contact__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.show_contact_info -%}
      <div class="corp-contact__info">
        {%- if section.settings.contact_email != blank -%}
          <div class="corp-contact__info-item">
            <span class="corp-contact__info-label">Email</span>
            <a href="mailto:{{ section.settings.contact_email }}" style="color:inherit;text-decoration:none;">{{ section.settings.contact_email }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.contact_phone != blank -%}
          <div class="corp-contact__info-item">
            <span class="corp-contact__info-label">Phone / WhatsApp</span>
            {{ section.settings.contact_phone }}
          </div>
        {%- endif -%}
        {%- if section.settings.contact_note != blank -%}
          <div class="corp-contact__info-item">
            <span class="corp-contact__info-label">Turnaround</span>
            {{ section.settings.contact_note }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="corp-contact__form">
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <div class="corp-form-success" style="display:block;">
          {{ section.settings.success_message | default: "Thank you! We'll be in touch within 1–2 business days." }}
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <p style="color:#c0392b;font-size:14px;margin-bottom:16px;font-family:'Funnel Sans',sans-serif;">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="corp-form-row">
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-company">Company Name *</label>
            <input class="corp-form-input" id="corp-company" type="text" name="contact[company]" placeholder="Your company" required>
          </div>
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-name">Contact Person *</label>
            <input class="corp-form-input" id="corp-name" type="text" name="contact[name]" placeholder="Your name" required>
          </div>
        </div>

        <div class="corp-form-row">
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-email">Email *</label>
            <input class="corp-form-input" id="corp-email" type="email" name="contact[email]" placeholder="you@company.com" required>
          </div>
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-phone">Phone / WhatsApp</label>
            <input class="corp-form-input" id="corp-phone" type="tel" name="contact[phone]" placeholder="+91 00000 00000">
          </div>
        </div>

        <div class="corp-form-row">
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-type">Requirement Type *</label>
            <select class="corp-form-select" id="corp-type" name="contact[requirement_type]" required>
              <option value="" disabled selected>Select...</option>
              <option value="Corporate Gifting">Corporate Gifting</option>
              <option value="Team Uniform">Team Uniform / Workwear</option>
              <option value="Event Merchandise">Event Merchandise</option>
              <option value="Branded Collection">Branded Collection</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-qty">Estimated Quantity</label>
            <input class="corp-form-input" id="corp-qty" type="text" name="contact[quantity]" placeholder="e.g. 100 pieces">
          </div>
        </div>

        <div class="corp-form-row">
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-timeline">Timeline</label>
            <input class="corp-form-input" id="corp-timeline" type="text" name="contact[timeline]" placeholder="e.g. 6 weeks">
          </div>
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-budget">Approximate Budget</label>
            <input class="corp-form-input" id="corp-budget" type="text" name="contact[budget]" placeholder="e.g. ₹1,00,000">
          </div>
        </div>

        <div class="corp-form-row full">
          <div class="corp-form-group">
            <label class="corp-form-label" for="corp-message">Tell Us More</label>
            <textarea class="corp-form-textarea" id="corp-message" name="contact[body]" placeholder="Describe your requirements, any branding preferences, or questions..." rows="4"></textarea>
          </div>
        </div>

        <div class="corp-form-submit">
          <button type="submit" class="btn" style="min-width:200px;">
            {{ section.settings.submit_label | default: 'Submit Proposal Request' }}
          </button>
        </div>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Corp: Contact Form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GET IN TOUCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "REQUEST A PROPOSAL" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Tell us about your requirements and we'll get back to you within 1–2 business days." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit Proposal Request" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you! We'll be in touch within 1–2 business days." },
    { "type": "header", "content": "Contact Details (shown beside form)" },
    { "type": "checkbox", "id": "show_contact_info", "label": "Show contact details", "default": true },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "corporate@secondform.co" },
    { "type": "text", "id": "contact_phone", "label": "Phone / WhatsApp" },
    { "type": "text", "id": "contact_note", "label": "Response time note", "default": "We respond within 1–2 business days" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 42 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
        { "value": "default", "label": "Default" },
        { "value": "warm-dark", "label": "Warm Dark" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "Pure White" },
        { "value": "custom", "label": "Custom" }
    ]},
    { "type": "color", "id": "custom_bg", "label": "Background colour", "default": "#F9F8F5" },
    { "type": "color", "id": "custom_heading_color", "label": "Heading colour", "default": "#332925" },
    { "type": "color", "id": "custom_text_color", "label": "Body text colour", "default": "#523F38" }
  ],
  "presets": [
    { "name": "Corp: Contact Form" }
  ]
}
{% endschema %}
